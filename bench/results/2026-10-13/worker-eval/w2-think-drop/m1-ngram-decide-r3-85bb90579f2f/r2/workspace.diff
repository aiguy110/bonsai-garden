+def published_indices(summary_path):
+    """First-divergence character indices already published in a previously
+    committed summary.json, used when the gitignored full responses
+    (bench/.replay/outputs) are not available in this sandbox.
+
+    They come from the same replay run, so they are the correct values to
+    carry forward when the raw outputs cannot be re-read here."""
+    id_idx, ctl_idx = {}, {}
+    if summary_path.exists():
+        try:
+            d = json.loads(summary_path.read_text())
+        except (json.JSONDecodeError, OSError):
+            return id_idx, ctl_idx
+        for x in d.get("identity", []):
+            arm, phase = x.get("arm"), x.get("phase")
+            for m in x.get("mismatches", []):
+                ch = m.get("first_divergence_char")
+                if arm is not None and phase is not None and m.get("id") and ch is not None:
+                    id_idx[(arm, phase, m["id"])] = ch
+        for x in d.get("off_dual_vs_single_control", []):
+            role = x.get("role")
+            for m in x.get("mismatches", []):
+                ch = m.get("first_divergence_char")
+                if role is not None and m.get("id") and ch is not None:
+                    ctl_idx[(role, m["id"])] = ch
+    return id_idx, ctl_idx
+
