+LIVE_YAML = Path(__file__).resolve().parents[1] / "serving" / "llama-swap.bonsai-2-27b.yaml"
+
+
+def pinned_mmproj_path():
+    """The projector pinned by the live bonsai-2-27b entry (--mmproj line)."""
+    m = re.search(r"--mmproj\s+(\S+)", LIVE_YAML.read_text())
+    return m.group(1) if m else None
+
+
+def projector_loaded(candidate_dir, mmproj_path):
+    """Verify the pinned projector actually loaded in every A-prod phase log.
+
+    Each phase's server log must contain the
+    ``load_model: loaded multimodal model, '<pinned mmproj path>'`` line.
+    Returns (ok, per-log detail) where ok is True iff all four phase logs
+    are present and each carries the pinned mmproj load line.
+    """
+    logs = sorted(candidate_dir.glob("server_*.log"))
+    detail = []
+    for log in logs:
+        loaded = mmproj_path is not None and any(
+            "load_model: loaded multimodal model" in line and mmproj_path in line
+            for line in log.read_text().splitlines()
+        )
+        detail.append({"log": log.name, "loaded": loaded})
+    return len(detail) == 4 and all(x["loaded"] for x in detail), detail
+
