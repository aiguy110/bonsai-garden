+def confirm_pi_ai_source():
+    """Glob for pi-ai's openai-completions.js and print lines around 'thinkingSignature'.
+    Runs on the host; harmless if the file is not present in the sandbox."""
+    lines = []
+    src = (RECON / "sources.txt").read_text(encoding="utf-8")
+    pi_dir = None
+    for ln in src.splitlines():
+        if ln.startswith("pi_package_dir:"):
+            pi_dir = ln.split(":", 1)[1].strip()
+    dirs = [pathlib.Path(pi_dir) if pi_dir else None]
+    if pi_dir:
+        dirs.append(pathlib.Path(pi_dir).parent / "pi-ai")
+        dirs.append(pathlib.Path(pi_dir).parent / "node_modules" / "@earendil-works" / "pi-ai")
+    dirs.append(pathlib.Path(os.path.expanduser("~")) / "node_modules" / "@earendil-works" / "pi-ai")
+    candidates = set()
+    for d in dirs:
+        if d and d.exists():
+            candidates.update(glob.glob(str(d / "**/openai-completions.js"), recursive=True))
+    if not candidates:
+        lines.append("[pi-ai source] openai-completions.js not found on host; reasoning_content "
+                     "mapping inferred from recorded event_samples.json thinkingSignature blocks")
+    for p in sorted(candidates):
+        try:
+            text = p.read_text(encoding="utf-8")
+        except Exception as e:
+            lines.append(f"[pi-ai source] {p}: {e}")
+            continue
+        lines.append(f"[pi-ai source] {p}")
+        for i, l in enumerate(text.splitlines()):
+            if "thinkingSignature" in l or "reasoning" in l.lower() or "thinkingContent" in l:
+                lines.append(f"  L{i + 1}: {l[:140]}")
+    return lines
+
 
