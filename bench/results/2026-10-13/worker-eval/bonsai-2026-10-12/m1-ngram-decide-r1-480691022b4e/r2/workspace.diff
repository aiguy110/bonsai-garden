+            pct(row.get("ident_rate")),
+            div_col(row.get("mismatches", []))))
+    lines.append("")
+    lines.append("### off dual-vs-single control (batching baseline, no speculation)")
+    lines.append("")
+    lines.append("| phase (dual vs single) | n (dual fg) | same sha | identical | first-divergence char index |")
+    lines.append("|---|---:|---:|---:|---|")
+    for phase in PHASES:
