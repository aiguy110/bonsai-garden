+        lines.append("| %s (dual vs %s) | %d | %d | %s | %s |" % (
+            phase, phase.replace("dual-", "single-").replace("single-", "dual-"),
+            ctl["n"], ctl["same"], pct(ctl["ident_rate"]),
+            div_col(ctl.get("mismatches", []))))
+    lines.append("")
+    lines.append("## Deployment rules (best spec arm = `%s`, prod sampling)"
+                 % (best_cfg or "n/a"))
+    lines.append("")
+    lines.append("| # | rule | result | value |")
+    lines.append("|---|---|---|---|")
+    for r in rule_details:
+        status = "PASS" if r["status"] else "FAIL"
+        lines.append("| %d | %s | **%s** | %s |" % (r["n"], r["rule"], status, r["value"]))
+    lines.append("")
+    lines.append("## Decision")
+    if deploy:
+        lines.append("**Deploy warranted:** best arm `%s` satisfies all six rules." % best_cfg)
+        lines.append("Create `serving/candidates/bonsai-2-27b.ngram.yaml` (copy of the live "
+                     "entry with only the spec flags appended to `cmd`) and submit an `infra` "
+                     "request. `deploy.json` will then hold the returned infra JSON.")
+    else:
+        lines.append("**No deployment.** Rules failed for the best arm "
+                     "`%s`: %s. The live `bonsai-2-27b` entry is left unchanged."
+                     % (best_cfg, "; ".join(deploy_why)))
+    lines.append("")
+    lines.append("_Computed by `bench/spec_summarize.py` from "
+                 "`%s/replay/*/requests.jsonl`._" % outdir)
+
+    with open(os.path.join(outdir, "summary.md"), "w") as f:
+        f.write("\n".join(lines) + "\n")
+
+    # ---- summary.json ----
+    summary = {
+        "outdir": outdir,
+        "arms": arms,
+        "missing_arms": missing_arms,
+        "best_config": best_cfg,
+        "metrics": metric_rows,
+        "identity": [summ(r) for r in identity],
+        "identity_control": {p: summ(ctl) for p, ctl in control.items()},
+        "commands": cmds,
+        "warnings": warnings,
