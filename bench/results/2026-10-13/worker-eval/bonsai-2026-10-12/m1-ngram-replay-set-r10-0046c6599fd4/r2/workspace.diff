+def est_chars(messages, tools=None, reasoning=None):
+    """Serialized-body char estimate. reasoning: True=all assistant thinking,
+    'after_last_user'=only assistant turns after the last role=user message (usual
+    Qwen-template behaviour), otherwise none."""
+    n = sum(base_msg_chars(m) for m in messages)
+    if reasoning is True:
+        n += sum(reasoning_chars(m) for m in messages)
+    elif reasoning == "after_last_user":
+        lu = last_user_index(messages)
+        for i, m in enumerate(messages):
+            if i > lu and m.get("role") == "assistant":
+                n += reasoning_chars(m)
