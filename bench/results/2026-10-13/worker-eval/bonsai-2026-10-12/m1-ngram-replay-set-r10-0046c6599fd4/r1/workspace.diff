+# ---------- source verification ----------
+
+def verify_pi_ai_converter():
+    """(advisor, round 10 item 4) On the host, glob for pi-ai's
+    openai-completions.js under the pi package (pi_package_dir from
+    recon/sources.txt, or the sibling @earendil-works/pi-ai) and print the
+    lines around 'thinkingSignature' so the assistant->body mapping is
+    confirmed from source."""
+    pkg = None
+    src = RECON / "sources.txt"
+    if src.exists():
+        for line in src.read_text(encoding="utf-8").splitlines():
+            if line.startswith("pi_package_dir:"):
+                pkg = line.split(":", 1)[1].strip()
+                break
+    candidates = set()
+    if pkg:
+        p = pathlib.Path(pkg)
+        if p.exists():
+            candidates |= {x for pattern in (
+                "node_modules/@earendil-works/pi-ai/dist/*/openai-completions.js",
+                "node_modules/@earendil-works/pi-ai/dist/openai-completions.js",
+                "**/node_modules/@earendil-works/pi-ai/dist/*/openai-completions.js",
+                "**/node_modules/@earendil-works/pi-ai/dist/openai-completions.js",
+            ) for x in p.glob(pattern)}
+            sib = p.parent / "node_modules" / "@earendil-works" / "pi-ai"
+            if sib.exists():
+                candidates |= {x for pattern in (
+                    "dist/*/openai-completions.js",
+                    "dist/openai-completions.js",
+                ) for x in sib.glob(pattern)}
+    for f in sorted(candidates):
+        try:
+            txt = f.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            continue
+        out = [f"CONVERTER: {f}"]
+        shown = 0
+        lines = txt.splitlines()
+        for i, ln in enumerate(lines):
+            if "thinkingSignature" in ln or "reasoning_content" in ln or \
+                    "OPENAI_COMPLETIONS_REASONING_FIELDS" in ln:
+                out.append(f"  {f}: line {i+1}: {ln}")
+                for j in range(max(0, i - 2), min(len(lines), i + 3)):
+                    out.append(f"    {j+1}: {lines[j]}")
+                shown += 1
+                if shown >= 4:
+                    break
+        if out:
+            out.append("")
+    print("\n".join(out).strip())
+    print()
+
+
