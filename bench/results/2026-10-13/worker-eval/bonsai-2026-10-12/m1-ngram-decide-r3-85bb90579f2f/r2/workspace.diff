+def pinned_mmproj_path():
+    """Path of the --mmproj argument pinned in the live entry's cmd block.
+
+    Used only to display rule 1's evidence against the live entry's pinned line.
+    Returns None if the entry or the argument cannot be read.
+    """
+    try:
+        text = (Path(__file__).resolve().parent.parent /
+                "serving/llama-swap.bonsai-2-27b.yaml").read_text()
+    except OSError:
+        return None
+    m = re.search(r"--mmproj\s+(\S+)", text)
+    return m.group(1) if m else None
+
+
+def mmproj_load_proof(replay, arm):
+    """Rule 1: verify the pinned projector actually loaded in every phase log.
+
+    Reads the four per-phase server logs of ``arm`` and returns
+    ``(all_loaded, proofs)``.  Each proof is ``{phase, loaded, line, loaded_path}``;
+    a phase is ``loaded`` only when its log contains a line matching
+    ``load_model: loaded multimodal model, '<path>'`` where the path contains
+    'mmproj'."""
+    pattern = re.compile(r"load_model:\s+loaded multimodal model,\s*'([^']*)'")
+    proofs = []
+    for phase in PHASES:
+        log = replay / arm / ("server_" + phase + ".log")
+        line = loaded_path = None
+        if log.exists():
+            for l in log.read_text().splitlines():
+                m = pattern.search(l)
+                if m and "mmproj" in m.group(1).lower():
+                    line = l
+                    loaded_path = m.group(1)
+                    break
+        proofs.append({"phase": phase, "loaded": line is not None,
+                       "line": line, "loaded_path": loaded_path})
+    return all(p["loaded"] for p in proofs), proofs
+
+
