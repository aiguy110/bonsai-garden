+#!/usr/bin/env python3
+"""Run the protected site metadata checker (tools/check_site.py) against site/.
+
+Used only as a thin launcher from `run` requests, which expect the script
+path to live under bench/ or evals/ while tools/check_site.py itself stays
+protected.
+"""
+import subprocess
+import sys
+
+rc = subprocess.run(
+    [sys.executable, "tools/check_site.py", "site"],
+    cwd="/home/dev/garden",
+)
+sys.exit(rc.returncode)
