+LIVE_ENTRY = Path(__file__).resolve().parent.parent / "serving" / "llama-swap.bonsai-2-27b.yaml"
+
+
+def pinned_mmproj_path():
+    """The --mmproj path pinned in the live bonsai-2-27b entry."""
+    match = re.search(r"--mmproj\s+(\S+)", LIVE_ENTRY.read_text(errors="ignore"))
+    return match.group(1) if match else None
+
+
+def projector_loaded(arm_dir):
+    """Rule 1: the pinned projector must be shown loaded in every A-prod
+    phase server log, not inferred from notes. Returns (ok, value)."""
+    pinned = pinned_mmproj_path()
+    if pinned is None:
+        return False, "no --mmproj line found in the live entry"
+    needle = f"loaded multimodal model, '{pinned}'"
+    missing = []
+    for phase in PHASES:
+        log = arm_dir / f"server_{phase}.log"
+        text = log.read_text(errors="ignore") if log.exists() else ""
+        if needle not in text:
+            missing.append(phase)
+    if missing:
+        return False, "pinned projector " + pinned + " not shown loaded in: " + ", ".join(missing)
+    return True, "pinned projector " + pinned + " loaded in all four A-prod phase server logs"
+
+
 def fnum(x, digits=1):
