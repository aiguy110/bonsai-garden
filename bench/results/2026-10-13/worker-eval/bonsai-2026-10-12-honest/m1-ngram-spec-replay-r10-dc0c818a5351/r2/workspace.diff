+#!/usr/bin/env python3
+"""Thin host-side wrapper: run the repo's site structure checker.
+
+The checker itself lives in tools/check_site.py (protected, read-only from here).
+Run with:  python3 bench/site_check_wrapper.py
+"""
+import os
+import subprocess
+import sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+check = os.path.join(ROOT, "tools/check_site.py")
+site = os.path.join(ROOT, "site")
+proc = subprocess.run([sys.executable, check, site])
+sys.exit(proc.returncode)
