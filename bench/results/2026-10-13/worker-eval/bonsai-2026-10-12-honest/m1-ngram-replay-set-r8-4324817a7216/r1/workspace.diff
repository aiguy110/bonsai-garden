+def build_manifest(agent_bodies, mem_bodies, additive):
+    manifest = {}
+
+    # per-request stats
+    per_request = []
+    for b in agent_bodies + mem_bodies:
+        hist = b["history"]
+        # prompt text = system + user parts
+        prompt_text = ""
+        for m in hist:
+            if m.get("role") in ("system", "user", "tool"):
+                prompt_text += str(m.get("content", "")) + "\n"
+        est_tokens_chars4 = len(prompt_text) / 4.0
+        rec_tokens = b.get("prompt_tokens")
+        per_request.append({
+            "id": b["id"],
+            "role": b["role"],
+            "n_messages": b["n_messages"],
+            "prompt_chars": len(prompt_text),
+            "est_tokens_chars4": est_tokens_chars4,
+            "recorded_prompt_tokens": rec_tokens,
+            "est_over_recorded": (est_tokens_chars4 / rec_tokens
+                                  if rec_tokens else None),
+        })
+
+    # totals per role
+    totals = {}
+    for role in ("agent", "mem"):
+        rs = [p for p in per_request if p["role"] == role]
+        ratios = [p["est_over_recorded"] for p in rs if p["est_over_recorded"] is not None]
+        distinct = len({p["id"].rsplit("/", 1)[0] for p in rs})
+        totals[role] = {
+            "requests": len(rs),
+            "distinct_steps": distinct,
+            "prompt_chars": sum(p["prompt_chars"] for p in rs),
+            "recorded_prompt_tokens": sum(p["recorded_prompt_tokens"] for p in rs),
+            "median_ratio": statistics.median(ratios) if ratios else None,
+        }
+
+    manifest["per_request"] = per_request
+    manifest["totals"] = totals
+
+    # system prompt exact: only 2-message first requests can support the join
+    agent_first = [p["est_over_recorded"]
+                   for p in per_request if p["role"] == "agent" and p["n_messages"] <= 3]
+    first_ratios_ok = (not agent_first) or all(0.75 <= r <= 1.33 for r in agent_first)
+    manifest["system_prompt_exact"] = first_ratios_ok
+    manifest["system_prompt_note"] = (
+        "agent system prompt = recorded sections joined by '\\n\\n' "
+        "(join inferred; getSystemMessageText not in source dump)"
+    )
+    manifest["agent_first_ratios"] = agent_first
+    manifest["n_messages_mismatches"] = (
+        len([p for p in per_request
+             if p["role"] == "agent" and p["n_messages"] is not None])
+    )
+    manifest["outliers"] = (
+        [p["id"] for p in per_request
+         if p["est_over_recorded"] is not None
+         and (p["est_over_recorded"] < 0.75 or p["est_over_recorded"] > 1.33)]
+    )
+    return manifest
 
 
