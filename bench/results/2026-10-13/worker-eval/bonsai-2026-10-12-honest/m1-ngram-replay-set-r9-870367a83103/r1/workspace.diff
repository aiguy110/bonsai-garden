+#!/usr/bin/env python3
+"""Diagnose the low agent est/recorded ratio by reconstructing message content
+and comparing per-message char lengths against recorded prompt token counts."""
+import json, pathlib, re
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+RECON = ROOT / "bench/results/2026-10-12/m1-ngram/recon"
+inv = json.loads((RECON / "inventory.json").read_text())
+
+def read_events(path):
+    msgs = None
+    sysmsg = None
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            if "message_update" in line[:80]:
+                continue
+            try:
+                e = json.loads(line)
+            except ValueError:
+                continue
+            t = e.get("type")
+            if t == "message_start" and sysmsg is None and e["message"].get("role") == "system":
+                sysmsg = e["message"]
+            elif t == "agent_end":
+                msgs = e["messages"]
+    return sysmsg, msgs
+
+def bt(c):
+    if isinstance(c, str):
+        return c
+    if isinstance(c, list):
+        return "".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
+    return str(c)
+
+for runid in ["inventory-mem0-r2", "inventory-baseline-r0"]:
+    run = [r for r in inv["runs"] if r["run_id"] == runid][0]
+    for sk in ["0"]:
+        st = run["steps"][sk]
+        evf = st["events_file"]
+        sysmsg, msgs = read_events(evf)
+        print("=" * 70)
+        print(runid, "step", sk, "msgs in agent_end:", len(msgs) if msgs else None)
+        # system
+        if sysmsg:
+            print("  system keys:", list(sysmsg.keys()))
+            secs = sysmsg.get("sections") or {}
+            print("  system sections:", {k: len(str(v)) for k, v in secs.items()})
+            print("  system total len:", len(bt(sysmsg.get("content"))), "sections-joined:", len("\n\n".join(str(v) for v in secs.values())))
+            print("  toolsAdded:", [t.get("name") for t in sysmsg.get("toolsAdded", [])])
+        # per-message content lengths (raw, pre-conversion) for first ~8
+        print("  --- raw message content lengths ---")
+        for i, m in enumerate(msgs[:10]):
+            c = m.get("content")
+            if isinstance(c, list):
+                cl = sum(len(bt(b)) for b in c if isinstance(b, dict))
+                typ = c and (c[0].get("type") if isinstance(c[0], dict) else None)
+            else:
+                cl = len(c)
+                typ = "str"
+            keys = [k for k in m.keys() if k not in ("content",)]
+            print(f"  [{i}] role={m.get('role')} len={cl} type={typ} keys={keys} ts={m.get('timestamp')}")
+        # show one full toolResult and one assistant with tool calls
+        print("  --- full sample messages ---")
+        shown = 0
+        for i, m in enumerate(msgs):
+            if shown >= 4:
+                break
+            if m.get("role") in ("toolResult", "assistant"):
+                shown += 1
+                s = json.dumps(m)
+                print(f"\n  MSG[{i}] role={m.get('role')} (len {len(s)} chars, preview 150):")
+                print("   " + s[:150])
