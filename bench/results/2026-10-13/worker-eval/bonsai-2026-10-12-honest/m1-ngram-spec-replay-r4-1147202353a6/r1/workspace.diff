+#!/usr/bin/env python3
+"""Full advisor-driven analysis of the greedy replay arms."""
+import json
+from pathlib import Path
+
+BASE = Path("bench/results/2026-10-12/m1-ngram/replay")
+PHASES = ["single-agent", "single-mem", "dual-agent", "dual-mem"]
+ARMS = {"off": "off-greedy", "A": "A-greedy", "B": "B-greedy"}
+
+def rows_of(arm, phase, role):
+    out = []
+    for line in open(BASE / ARMS[arm] / "requests.jsonl"):
+        r = json.loads(line)
+        if r["phase"] == phase and r["role"] == role:
+            out.append(r)
+    return out
+
+def load(arm, role):
+    d = {}
+    for role_, phase in (("agent", "single-agent"), ("agent","dual-agent"),
+                         ("agent","dual-mem"), ("mem","single-mem"),
+                         ("mem","dual-mem"), ("mem","dual-agent")):
+        pass
+    return d
+
+def phase_role(arm, phase):
+    return "agent" if "agent" in phase else "mem"
+
+print("=== Per-phase fg tok/s: with vs without length rows ===")
+print(f"{'arm':3} {'phase':12} {'role':4} {'n':>3} {'tok/s':>6} {'excl':>6} {'len-ids':18}")
+for arm in ARMS:
+    for phase in PHASES:
+        role = phase_role(arm, phase)
+        rs = [r for r in rows_of(arm, phase, role) if r.get("fg_bg") == "fg"]
+        n = sum(r["predicted_n"] for r in rs)
+        ms = sum(r["predicted_ms"] for r in rs)
+        rs_ex = [r for r in rs if r.get("finish_reason") != "length"]
+        n_ex = sum(r["predicted_n"] for r in rs_ex)
+        ms_ex = sum(r["predicted_ms"] for r in rs_ex)
+        len_ids = [r["id"] for r in rs if r.get("finish_reason") == "length"]
+        print(f"{arm:3} {phase:12} {role:4} {len(rs):>3} {n/(ms/1000):6.1f} {n_ex/(ms_ex/1000) if ms_ex else 0:6.1f} {', '.join(len_ids) if len_ids else '-':18}")
+
+print("\n=== Length rows: predicted_n across arms + off behavior ===")
+all_len_ids = set()
+for arm in ARMS:
+    for phase in PHASES:
+        role = phase_role(arm, phase)
+        for r in rows_of(arm, phase, role):
+            if r.get("fg_bg") == "fg" and r.get("finish_reason") == "length":
+                all_len_ids.add((arm, phase, r["id"], r["predicted_n"]))
+print("arm/phase/id/predicted_n:")
+for a, p, i, pn in sorted(all_len_ids):
+    print(f"  {a}/{p}/{i} = {pn}")
+
+# For each id that is length in A, what did off do (same phase+role)?
+print("\nA length-row ids -> off behavior (same phase):")
+for a, p, i, pn in sorted(all_len_ids):
+    if a != "A": continue
+    role = phase_role("off", p)
+    off_rows = [r for r in rows_of("off", p, role) if r.get("fg_bg") == "fg" and r["id"] == i]
+    for o in off_rows:
+        print(f"  {p}/{i}: A={pn}tok length | off: finish={o.get('finish_reason')} n={o.get('predicted_n')}")
+
+print("\n=== Output identity per phase vs off (same phase, same id) ===")
+for phase in PHASES:
+    role = phase_role("off", phase)
+    off = {r["id"]: r["out_sha256"] for r in rows_of("off", phase, role) if r.get("fg_bg")=="fg"}
+    for arm in ("A", "B"):
+        m = 0; same = 0
+        for r in rows_of(arm, phase, role):
+            if r.get("fg_bg") != "fg": continue
+            m += 1
+            if off.get(r["id"]) == r.get("out_sha256"):
+                same += 1
+        print(f"  {phase} arm {arm} vs off: {same}/{m} identical ({100*same/m:.0f}%)")
+
+print("\n=== 'restore checkpoint' counts in A/B server logs ===")
+for arm in ("A", "B"):
+    d = BASE / ARMS[arm]
+    total = 0
+    for phase in PHASES:
+        lg = d / f"server_{phase}.log"
+        try:
+            c = sum(1 for ln in open(lg, errors="replace") if "restore checkpoint" in ln)
+            total += c
+        except OSError:
+            pass
+    print(f"  arm {arm}: {total} 'restore checkpoint' lines across all phases")
+
+print("\n=== 'ngram-mod n-match=12 is too small' in B logs ===")
+for phase in PHASES:
+    lg = BASE / ARMS["B"] / f"server_{phase}.log"
+    c = sum(1 for ln in open(lg, errors="replace") if "too small" in ln)
+    if c: print(f"  {phase}: {c}")
