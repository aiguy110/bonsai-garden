+#!/usr/bin/env python3
+"""Analyze spec-replay requests.jsonl files: per-phase foreground tok/s,
+length finishes, draft stats, and combined throughput estimates."""
+import json, sys
+from pathlib import Path
+
+def phase_tok_s(path, phase, role="agent"):
+    rows = [json.loads(l) for l in open(path)]
+    fg = [r for r in rows if r["phase"] == phase and r["role"] == role and r["fg_bg"] == "fg"]
+    total_n = sum(r["predicted_n"] for r in fg)
+    total_ms = sum(r["predicted_ms"] for r in fg)
+    total_n_excl = sum(r["predicted_n"] for r in fg if r["finish_reason"] != "length")
+    total_ms_excl = sum(r["predicted_ms"] for r in fg if r["finish_reason"] != "length")
+    length_rows = [r["id"] for r in fg if r["finish_reason"] == "length"]
+    drafts = [(r["id"], r.get("draft_n") or 0, r.get("draft_n_accepted") or 0, r.get("max_tokens")) for r in fg]
+    return total_n, total_ms, total_n_excl, total_ms_excl, length_rows, drafts
+
+if __name__ == "__main__":
+    base = Path("/home/dev/garden/bench/results/2026-10-12/m1-ngram/replay")
+    dirs = {"off": "off-greedy", "A": "A-greedy", "B": "B-greedy"}
+    phases = ["single-agent", "single-mem", "dual-agent", "dual-mem"]
+    print(f"{'arm':3} {'phase':12} {'fg tok/s':>9} {'excl len':>10} {'len rows':10} {'draft total':>14} {'accept%':>9}")
+    for arm, d in dirs.items():
+        for phase in phases:
+            role = "agent" if "agent" in phase else "mem"
+            total_n, total_ms, tn, tms, lr, drafts = phase_tok_s(base / d / "requests.jsonl", phase, role)
+            tok_s = total_n / (total_ms / 1000)
+            tok_s_excl = tn / (tms / 1000) if tms else 0.0
+            dn = sum(x[1] for x in drafts)
+            da = sum(x[2] for x in drafts)
+            acc = da / dn * 100 if dn else 0.0
+            lr_str = ", ".join(lr) if len(lr) < 3 else f"{len(lr)}"
+            print(f"{arm:3} {phase:12} {tok_s:9.1f} {tok_s_excl:10.1f} {lr_str:10} {dn:14} {acc:8.1f}")
