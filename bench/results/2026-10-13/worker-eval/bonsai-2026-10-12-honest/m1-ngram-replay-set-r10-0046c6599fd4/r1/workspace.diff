+def confirm_thinking_source():
+    """Locate pi-ai's openai-completions.js and print lines around the
+    thinkingSignature / reasoning_content mapping (pi-ai sends the recorded
+    thinkingSignature back as the message key)."""
+    out = []
+    pi_dir = _pi_package_dir()
+    tried = []
+    if pi_dir:
+        base = pathlib.Path(pi_dir).parent  # .../node_modules
+        patterns = ("@earendil-works/pi-ai/dist/providers/openai-completions.js",
+                    "pi-ai/dist/providers/openai-completions.js")
+        for pat in patterns:
+            tried.extend(str(f) for f in base.glob(pat) if f.is_file())
+    seen, shown = set(), set()
+    for f in tried:
+        if f in seen:
+            continue
+        seen.add(f)
+        out.append(f"SOURCE {f}")
+        raw = pathlib.Path(f).read_text(encoding="utf-8", errors="replace").splitlines()
+        hits = [i for i, ln in enumerate(raw)
+                if "thinkingSignature" in ln or "reasoning_content" in ln]
+        for i in hits[:6]:
+            for j in range(max(0, i - 4), min(len(raw), i + 5)):
+                shown.add(j)
+        for j in sorted(shown):
+            out.append(f"  {j + 1}: {raw[j].strip()}")
+        break
+    if not out:
+        out.append("SOURCE not found: tried " + ("; ".join(tried) or "no pi_package_dir"))
+    return out
+
