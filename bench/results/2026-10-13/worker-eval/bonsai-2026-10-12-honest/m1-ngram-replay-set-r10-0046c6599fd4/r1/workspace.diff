+def _reasoning_chars(m):
+    """Chars of string fields other than role/content (the reasoning_content field)."""
+    return sum(len(v) for k, v in m.items()
+               if isinstance(v, str) and k not in ("role", "content", "tool_call_id"))
+
+
+def _reasoning_after_last_user(messages):
+    """Reasoning chars of assistant messages after the last user message."""
+    last_user = -1
+    for i, m in enumerate(messages):
+        if m.get("role") == "user":
+            last_user = i
+    return sum(_reasoning_chars(m) for i, m in enumerate(messages)
+               if i > last_user and m.get("role") == "assistant")
+
