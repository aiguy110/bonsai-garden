+def pinned_mmproj_path():
+    """Pinned --mmproj path from the live serving entry (rule 1 condition)."""
+    path = Path(__file__).resolve().parent.parent / "serving" / "llama-swap.bonsai-2-27b.yaml"
+    for line in path.read_text().splitlines():
+        line = line.strip()
+        if line.startswith("--mmproj"):
+            return line.split(None, 1)[1].strip(" '\"")
+    return None
+
+
+def mmproj_log_loads(cand_dir):
+    """Per-phase projector-load evidence in the candidate's server logs.
+
+    Rule 1 requires the pinned projector to have actually loaded, verified from
+    all four phase server logs ('load_model: loaded multimodal model, <path>'),
+    not inferred from notes.txt.
+    """
+    found = {}
+    for phase in PHASES:
+        path = cand_dir / f"server_{phase}.log"
+        text = path.read_text() if path.exists() else ""
+        m = re.search(r"load_model: loaded multimodal model, '([^']*)'", text)
+        found[phase] = m.group(1) if m else None
+    return found
+
+
